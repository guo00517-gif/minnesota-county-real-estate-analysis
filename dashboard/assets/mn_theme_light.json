{
  "name": "Minnesota North Star (Light)",
  "dataColors": [
    "#002D5D",
    "#C9D1DB",
    "#52C9E8",
    "#677489",
    "#0B5394",
    "#A8DFF0",
    "#3E4C5E",
    "#E1E6ED"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A3A",
  "tableAccent": "#002D5D",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#002D5D"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#002D5D"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#677489"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#677489"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F7"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#002D5D"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": false,
            "rowPadding": 2,
            "outlineColor": {
              "solid": {
                "color": "#D5DBE3"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#677489"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2A3A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1B2A3A"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F8FA"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#677489"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDF0F4"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#677489"
              }
            }
          }
        ]
      }
    },
    "shapeMap": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ]
      }
    }
  }
}